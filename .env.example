# Copy to .env and fill in. Environment variables override config.toml.
CHESSCOM_USERNAME=your_chesscom_username
# Sent in the User-Agent so chess.com can reach you instead of blocking the client.
CONTACT_EMAIL=you@example.com

# Optional engine tuning (nested settings use a double underscore).
# ENGINE__THREADS=4
# ENGINE__HASH_MB=512
# ENGINE__DEPTH=18

# IANA timezone for time-of-day insights (default UTC).
TIMEZONE=Europe/London
